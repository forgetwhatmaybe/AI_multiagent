

# LLM配置
SF_API_KEY=
SF_BASE_URL=
MAIN_MODEL_NAME=deepseek-v4-flash

AL_BAILIAN_API_KEY=
AL_BAILIAN_BASE_URL=
SUB_MODEL_NAME=deepseek-v4-flash

# MySQL配置
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=its
MYSQL_CHARSET=utf8mb4
MYSQL_CONNECT_TIMEOUT=10
MYSQL_MAX_CONNECTIONS=5

# MCP配置
# 百炼托管 MCP：每个服务一条专属 URL，鉴权用百炼 API Key（Header: Authorization: Bearer xxx）
# 注意：百炼已从 SSE 切换为 Streamable HTTP 协议，URL 以 /mcp 结尾
DASHSCOPE_BASE_URL=

DASHSCOPE_API_KEY=
# 百度地图官方 MCP：AK 直接拼在 URL query 里，不走百炼 Key
BAIDUMAP_AK=
BAIDUMAP_MCP_URL=

# 知识库配置
KNOWLEDGE_BASE_URL=http://127.0.0.1:8001
